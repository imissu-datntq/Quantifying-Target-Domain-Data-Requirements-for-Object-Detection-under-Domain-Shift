+/* Research output uses raw head indices and already corrected original pixels.
+ * One record per image (including empty detections) proves inference coverage. */
+void print_research_detections(FILE *fp, int index, detection *dets, int total,
+                              int classes, int w, int h)
+{
+    fprintf(fp, "{\"index\":%d,\"width\":%d,\"height\":%d,\"detections\":[", index, w, h);
+    int first = 1;
+    for (int i = 0; i < total; ++i) {
+        box b = dets[i].bbox;
+        for (int j = 0; j < classes; ++j) {
+            float score = dets[i].prob[j];
+            if (!isfinite(score) || !isfinite(b.x) || !isfinite(b.y) ||
+                !isfinite(b.w) || !isfinite(b.h)) {
+                fprintf(stderr, "Non-finite research detection\n");
+                exit(EXIT_FAILURE);
+            }
+            if (score <= 0) continue;
+            fprintf(fp, "%s[%d,%.9g,%.9g,%.9g,%.9g,%.9g]", first ? "" : ",",
+                    j, score, b.x-b.w/2, b.y-b.h/2, b.x+b.w/2, b.y+b.h/2);
+            first = 0;
+        }
+    }
+    fprintf(fp, "]}\n");
+    if (fflush(fp) != 0) { perror("research output"); exit(EXIT_FAILURE); }
+}
